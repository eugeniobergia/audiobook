# Static key clients must send in the X-API-Key header.
API_KEY=change-me

# Shared by the app and the official postgres image (docker compose).
POSTGRES_USER=audiobook
POSTGRES_PASSWORD=audiobook
POSTGRES_DB=audiobook

# Use "db" (the compose service name) when the API runs inside docker compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where the API server listens. docker compose sets HOST=0.0.0.0 for the container.
HOST=localhost
PORT=8000

# Optional. iTunes Search API base URL and request timeout. Set the URL to something
# unreachable (e.g. http://localhost:9) to see ingestion fall back to the saved sample.
# ITUNES_BASE_URL=https://itunes.apple.com
# ITUNES_TIMEOUT_SECONDS=10
